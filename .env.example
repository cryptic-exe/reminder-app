# Postgres (Neon, local, or any Postgres URL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# Single-user password gate (login page)
APP_PASSWORD="change-me"

# Session cookie signing — use a long random string (32+ chars)
SESSION_SECRET="generate-a-long-random-string"

# Prefer a JSON file for free LLM keys (Next.js can strip quotes from huge inline env).
# Copy FreeLLMAPI-style export to llm-keys.json (gitignored) and point here:
LLM_KEYS_FILE=./llm-keys.json
# Or a small inline map: LLM_KEYS_JSON={"groq":["gsk_your_key"]}

# IANA timezone for parsing "tomorrow at 9", clock times, etc.
USER_TIMEZONE="Asia/Kolkata"

# WAHA WhatsApp HTTP API (self-hosted; must include http:// or https://)
WAHA_BASE_URL="http://127.0.0.1:3001"
WAHA_API_KEY="your-waha-api-key"
WAHA_SESSION="default"
# On the WAHA server, enable media download so voice notes include media.url:
# WHATSAPP_DOWNLOAD_MEDIA=true
# Default chat: international digits + @c.us (or a group @g.us id)
WHATSAPP_CHAT_ID="91XXXXXXXXXX@c.us"

# Protects /api/cron/dispatch (Vercel Cron: Authorization: Bearer …)
CRON_SECRET="generate-another-long-random-string"

# Optional: WAHA inbound webhook auth (defaults to CRON_SECRET)
# WAHA_WEBHOOK_SECRET="same-or-other-secret"

# Capacitor native shell URL (deployed Next app)
# CAPACITOR_SERVER_URL=https://your-app.vercel.app
